rows = 5

# Upper Half
for i in range(1, rows + 1):

    # Left Stars
    for j in range(i):
        print("*", end="")

    # Spaces
    for j in range(2 * (rows - i)):
        print(" ", end="")

    # Right Stars
    for j in range(i):
        print("*", end="")

    print()

