# syntax  datetime.strptime("date_string", "format")


from datetime import datetime

date = datetime.strptime("25-08-2026", "%d-%m-%Y")
print(date)



#strptime() — Program 2: User Input Date को Datetime में Convert करना

date_string = input("\nEnter date: ")
date = datetime.strptime(date_string, "%d-%m-%Y")
print(date)



#strptime() — Program 3: Date + Time को Datetime में Convert करना

date = datetime.strptime("25-08-2026 14:30:25", "%d-%m-%Y %H:%M:%S")
print(date)



#strptime() — Program 4: User Input से Date + Time Convert करना

date_string = input("\nEnter date and time: ")
date = datetime.strptime(date_string, "%d-%m-%Y %H:%M:%S")
print(date)



#strptime() — Program 5: Converted Date से Year, Month और Day निकालना

date = datetime.strptime("25-08-2026", "%d-%m-%Y")
print(date.year)
print(date.month)
print(date.day)



#strptime() — Program 6: Converted Date का Weekday Number निकालना

date = datetime.strptime("28-08-2026", "%d-%m-%Y")
day = date.weekday()
print(day)



#strptime() — Program 7: YYYY-MM-DD Date को Convert करन

date = datetime.strptime("2000-8-2", "%Y-%m-%d")
print(date)



#strptime() — Program 8: Text Month वाली Date Convert करना

date = datetime.strptime("25 August 2026", "%d %B %Y")
print(date)



#Short Month Name

date = datetime.strptime("25 Aug 2026", "%d %b %Y")
print(date)



#केवल Time को strptime() से Convert करना

date = datetime.strptime("14:30:25", "%H:%M:%S")
print(date)



#12-Hour Time को strptime() से Convert करना

date = datetime.strptime("10:30:25 PM", "%I:%M:%S %p")
print(date)



#12-Hour Time — AM के साथ

date = datetime.strptime("10:30:25 AM", "%I:%M:%S %p")
print(date)



#Date + 12-Hour Time (AM/PM)

date = datetime.strptime(
    "25-08-2026 10:30:25 PM",
    "%d-%m-%Y %I:%M:%S %p"
)

print(date)




#User Input — Date + 12-Hour Time (AM/PM)

date_string = input("Enter date and time: ")

date = datetime.strptime(
    date_string,
    "%d-%m-%Y %I:%M:%S %p"
)

print(date)



#strptime() से Date और Time Parts निकालना

date = datetime.strptime(
    "25-08-2026 10:30:25 PM",
    "%d-%m-%Y %I:%M:%S %p"
)

print(date.year)
print(date.month)
print(date.day)
print(date.hour)
print(date.minute)
print(date.second)




#strptime() से दो Dates Compare करना


date1 = datetime.strptime("25-08-2026", "%d-%m-%Y")
date2 = datetime.strptime("30-08-2026", "%d-%m-%Y")

if date1 > date2:
    print("Date 1 is greater")
elif date1 < date2:
    print("Date 2 is greater")
else:
    print("both date are equal")



#strptime() से दो Dates का Difference निकालना

date1 = datetime.strptime("25-08-2026", "%d-%m-%Y")
date2 = datetime.strptime("30-08-2026", "%d-%m-%Y")

difference = date2 - date1
print(difference.days)




#User की दो Dates का Difference

date1_string = input("Enter first date: ")
date2_string = input("Enter second date: ")

date1 = datetime.strptime(date1_string, "%d-%m-%Y")
date2 = datetime.strptime(date2_string, "%d-%m-%Y")

difference = date2 - date1

print(difference.days)



#strptime() — Program 19: User Date + Time का Difference

date1_string = input("Enter first date and time: ")

date2_string = input("Enter second date and time: ")

date1 = datetime.strptime(date1_string, "%d-%m-%Y %H:%M:%S")

date2 = datetime.strptime(date2_string, "%d-%m-%Y %H:%M:%S")

difference = date2 - date1

print(difference)




#strptime() — Program 20: Date + 12-Hour AM/PM Time Difference

date1 = datetime.strptime(
    "25-08-2026 10:30:00 AM",
    "%d-%m-%Y %I:%M:%S %p"
)

date2 = datetime.strptime(
    "25-08-2026 02:30:00 PM",
    "%d-%m-%Y %I:%M:%S %p"
)

difference = date2 - date1

print(difference)




#strptime() — Program 21: User Input — Date + 12-Hour AM/PM

date_string = input("Enter date and time: ")

date = datetime.strptime(
    date_string,
    "%d-%m-%Y %I:%M:%S %p"
)

print(date)




#strptime() — Program 22: / वाले Date Format को Convert करना

